{
  "version": 1,
  "items": {
    "reverse": { "label": "スクロール方向の反転", "desc": "有効にすると、ダイヤルをドラッグした際の回転方向が逆になります", "glyph": "swap", "type": "toggle", "bind": "reverseScroll" },
    "sleep": { "label": "スリープタイマー", "desc": "設定した時間が過ぎたら、再生中の音楽を自動で一時停止します", "glyph": "clock", "type": "special" },
    "updateApps": { "label": "アプリ一覧を更新", "desc": "追加・削除・更新されたアプリをチェックして、一覧に反映します（差分更新）。通常は起動時に自動でチェックされます", "glyph": "apps", "type": "action", "action": "updateApps" },
    "pageSwitch": { "label": "ボタンでページ切り替え", "desc": "オフにすると下部のダイヤルで切り替えます", "glyph": "toggle", "type": "choices", "bind": "pageSwitchStyle", "choices": [
      { "v": "buttons", "label": "ボタン" },
      { "v": "dial", "label": "ダイヤル" }
    ] },
    "discLayout": { "label": "ホーム画面の円の大きさ", "desc": "「アートワーク大きめ」では再生アートワークの円が大きくなります。「自動」は再生中だけ大きめになります", "glyph": "disc", "type": "choices", "bind": "homeDiscLayout", "choices": [
      { "v": "classic", "label": "従来（均等）", "illo": "disc_classic" },
      { "v": "artwork", "label": "アートワーク大きめ", "illo": "disc_artwork" },
      { "v": "auto", "label": "自動", "illo": "disc_auto" }
    ] },
    "disc3d": { "label": "UIを3D表示", "desc": "円・時計・ダイヤル・歌詞PVなどを少し奥に倒して、立体的に見せます", "glyph": "disc", "type": "toggle", "bind": "disc3d" },
    "disc3dTilt": { "label": "端末の傾きで角度を変える", "desc": "スマホを傾けると、3Dの角度もついてきます（3D表示がオンのときだけ）", "glyph": "disc", "type": "toggle", "bind": "disc3dTilt" },
    "dateMode": { "label": "日付の表示", "desc": "「常時縦」は日付を時刻の右に横倒しで、「常時横」は時計の下に表示します。「切り替え」は歌詞が出ている間だけ横倒しになります", "glyph": "clock", "type": "choices", "bind": "dateDisplayMode", "choices": [
      { "v": "sideways", "label": "常時縦", "illo": "date_sideways" },
      { "v": "under", "label": "常時横", "illo": "date_under" },
      { "v": "auto", "label": "切り替え", "illo": "date_auto" }
    ] },
    "bgMode": { "label": "背景の見せ方", "desc": "アートワークを選ぶと、再生中は曲のアートワーク由来の背景になります", "glyph": "image", "type": "choices", "bind": "bgMode", "choices": [
      { "v": "wallpaper", "label": "壁紙", "illo": "bg_wallpaper" },
      { "v": "artwork_solid", "label": "単色", "illo": "bg_solid" },
      { "v": "artwork_blur", "label": "ぼかし", "illo": "bg_blur" }
    ] },
    "liquid": { "label": "液体グラデーション背景", "desc": "壁紙がないときや再生中のアートワーク背景の上で、グラデーションがゆっくり動きます", "glyph": "color", "type": "toggle", "bind": "liquidBackground" },
    "wallpaperPick": { "label": "壁紙画像を選択", "desc": "ホーム画面の背景にする画像を選びます", "glyph": "image", "type": "action", "action": "wallpaperPick" },
    "wallpaperClear": { "label": "壁紙を解除", "desc": "カスタム壁紙をやめて標準の背景に戻します", "glyph": "image", "type": "action", "action": "wallpaperClear", "visibleIf": "wallpaperSet" },
    "brightness": { "label": "ホーム背景の明るさ", "desc": "壁紙の上に重ねる暗さの調整です", "glyph": "slider", "type": "slider", "bind": "wallpaperAlpha", "min": 0.05, "max": 0.9, "steps": 17, "format": "percentInv" },
    "matchArtwork": { "label": "アートワークに合わせる", "desc": "再生中の曲のアートワークから、アクセントと背景の色を自動で決めます", "glyph": "color", "type": "toggle", "bind": "matchArtwork" },
    "accentColor": { "label": "アクセントカラー", "desc": "UIの差し色です（アートワーク連動がオンのときは自動の色が優先されます）", "glyph": "color", "type": "choices", "bind": "accentHex", "choices": [
      { "v": "#E53935", "label": "赤", "colorHex": "#E53935" },
      { "v": "#88C0FF", "label": "青", "colorHex": "#88C0FF" },
      { "v": "#4CAF50", "label": "緑", "colorHex": "#4CAF50" },
      { "v": "#AB47BC", "label": "紫", "colorHex": "#AB47BC" },
      { "v": "#FF9800", "label": "オレンジ", "colorHex": "#FF9800" },
      { "v": "#00E5FF", "label": "シアン", "colorHex": "#00E5FF" },
      { "v": "#FF4081", "label": "ピンク", "colorHex": "#FF4081" }
    ] },
    "uiFont": { "label": "UIフォント", "desc": "ランチャー全体の文字のフォントです", "glyph": "font", "type": "choices", "bind": "fontChoice", "choices": [
      { "v": "default", "label": "システムフォント", "short": "システム" },
      { "v": "receipt", "label": "レシートフォント", "short": "レシート" },
      { "v": "denkichip", "label": "でんきチップ" },
      { "v": "tsukuhou", "label": "築豊明朝" },
      { "v": "kaibunsho", "label": "怪聞書フォント", "short": "怪聞書" },
      { "v": "zenkaku", "label": "Zen Kaku Gothic New", "short": "Zen Kaku" },
      { "v": "custom", "label": "＋カスタムフォント", "short": "カスタム", "effect": "pickFont" }
    ] },
    "iconSize": { "label": "アイコンサイズ", "desc": "アプリ円盤のアイコンの大きさです", "glyph": "slider", "type": "slider", "bind": "iconSize", "min": 16, "max": 32, "steps": 15, "format": "dp" },
    "textSize": { "label": "テキストサイズ", "desc": "アプリ円盤のアプリ名の大きさです", "glyph": "slider", "type": "slider", "bind": "textSize", "min": 12, "max": 22, "steps": 9, "format": "sp" },
    "letterSpacing": { "label": "文字間隔", "desc": "アプリ名の文字どうしの間隔です", "glyph": "slider", "type": "slider", "bind": "letterSpacing", "min": 0.5, "max": 3.0, "steps": 25, "format": "sp1" },
    "stepAngle": { "label": "リストの間隔", "desc": "アプリ円盤で1アプリぶんの回転角度です", "glyph": "slider", "type": "slider", "bind": "stepAngle", "min": 10, "max": 20, "steps": 20, "format": "deg" },
    "displayMode": { "label": "歌詞の表示モード", "desc": "複数行は時計の下に前・今・次の3行を表示します。リリックビデオはSpotifyなど他のアプリの再生でも使えます", "glyph": "music", "type": "choices", "bind": "lyricsDisplayMode", "choices": [
      { "v": "line", "label": "現在の行", "preview": "line" },
      { "v": "video", "label": "リリックビデオ", "preview": "video" },
      { "v": "multi", "label": "複数行", "preview": "multi" }
    ] },
    "jpFont": { "label": "歌詞のフォント", "desc": "全モード共通の歌詞フォントです。「カスタム」はフォント設定で選んだファイルを使います", "glyph": "font", "type": "choices", "bind": "lyricsPvFont", "choices": [
      { "v": "default", "label": "システムフォント", "short": "システム" },
      { "v": "receipt", "label": "レシートフォント", "short": "レシート" },
      { "v": "denkichip", "label": "でんきチップ" },
      { "v": "tsukuhou", "label": "築豊明朝" },
      { "v": "kaibunsho", "label": "怪聞書フォント", "short": "怪聞書" },
      { "v": "zenkaku", "label": "Zen Kaku Gothic New", "short": "Zen Kaku" },
      { "v": "custom", "label": "＋カスタムフォント", "short": "カスタム", "effect": "pickFontIfNone" }
    ] },
    "enFont": { "label": "歌詞の英字フォント", "desc": "歌詞の中の英字・数字だけに使うフォントです", "glyph": "font", "type": "choices", "bind": "lyricsEnFont", "choices": [
      { "v": "same", "label": "日本語フォントと同じ", "short": "日本語と同じ" },
      { "v": "freelicense", "label": "Free License" },
      { "v": "montserratbi", "label": "Montserrat Bold Italic", "short": "Montserrat" },
      { "v": "default", "label": "システムフォント", "short": "システム" },
      { "v": "receipt", "label": "レシートフォント", "short": "レシート" },
      { "v": "denkichip", "label": "でんきチップ" },
      { "v": "tsukuhou", "label": "築豊明朝" },
      { "v": "kaibunsho", "label": "怪聞書フォント", "short": "怪聞書" },
      { "v": "zenkaku", "label": "Zen Kaku Gothic New", "short": "Zen Kaku" },
      { "v": "custom", "label": "＋カスタムフォント", "short": "カスタム", "effect": "pickEnFont" }
    ] },
    "bold": { "label": "歌詞を太字にする", "desc": "デフォルトは細字。築豊明朝は細字が映えます", "glyph": "text", "type": "toggle", "bind": "lyricsBold" },
    "parts": { "label": "文字をパーツに分けて入場させる", "desc": "リリックビデオで、文字がスライス状のパーツになって集まります", "glyph": "sparkle", "type": "toggle", "bind": "pvPartsEntry" },
    "dopagaki": { "label": "ドパガキモード", "desc": "リリックビデオにエフェクトを大量に重ねて派手にします", "glyph": "sparkle", "type": "toggle", "bind": "dopagaki" },
    "dopaBlack": { "label": "ドパガキ中は極太フォント", "desc": "ドパガキモードのとき、歌詞を Zen Kaku Gothic New の極太（Black）で表示します", "glyph": "font", "type": "toggle", "bind": "dopaBlackFont" },
    "statusBar": { "label": "ステータスバーに歌詞を表示", "desc": "他のアプリの上にも、時計と同期歌詞1行を重ねます（重ねて表示の権限が必要）", "glyph": "music", "type": "special" },
    "fxUpdate": { "label": "歌詞エフェクトの更新", "desc": "単語アイコンや色の対応表を最新にします", "glyph": "update", "type": "action", "action": "fxUpdate" },
    "passcodeAuth": { "label": "非表示アプリのパスコード認証", "desc": "有効にすると、非表示リストを開く際にパスコード認証を行います", "glyph": "lock", "type": "toggle", "bind": "usePasscodeForHidden" },
    "passcodeChange": { "label": "パスコードを変更する", "desc": "非表示リスト解除用のパスコード (PIN) を変更します", "glyph": "lock", "type": "action", "action": "passcodeChange" },
    "guideReshow": { "label": "チュートリアルを再表示する", "desc": "ガイドや使い方をもう一度表示するようにします", "glyph": "guide", "type": "action", "action": "guideReshow" },
    "checkUpdate": { "label": "アップデートを確認", "desc": "GitHubの最新ビルドを確認します", "glyph": "update", "type": "action", "action": "checkUpdate" }
  },
  "tree": [
    { "id": "background", "label": "背景", "cat": true, "children": [
      { "id": "bg_image", "label": "背景画像", "glyph": "image", "children": [
        { "item": "bgMode" }, { "item": "wallpaperPick" }, { "item": "wallpaperClear" }, { "item": "brightness" }
      ] },
      { "id": "bg_liquid", "label": "液体", "glyph": "color", "children": [
        { "item": "liquid" }
      ] }
    ] },
    { "id": "ui", "label": "UI", "cat": true, "children": [
      { "id": "ui_color", "label": "カラー", "glyph": "palette", "children": [
        { "item": "accentColor" }, { "item": "matchArtwork" }
      ] },
      { "id": "ui_disc", "label": "円盤", "glyph": "disc", "children": [
        { "item": "reverse" }, { "item": "discLayout" }, { "item": "iconSize" }, { "item": "stepAngle" }, { "item": "disc3d" }, { "item": "disc3dTilt" }, { "item": "dateMode" }, { "item": "pageSwitch" }
      ] },
      { "id": "ui_text", "label": "文字", "glyph": "font", "children": [
        { "item": "uiFont" }, { "item": "textSize" }, { "item": "letterSpacing" }
      ] }
    ] },
    { "id": "lyrics", "label": "歌詞", "cat": true, "children": [
      { "id": "ly_text", "label": "文字", "glyph": "text", "children": [
        { "item": "jpFont" }, { "item": "enFont" }, { "item": "bold" }, { "item": "dopaBlack" }
      ] },
      { "id": "ly_anim", "label": "アニメーション", "glyph": "sparkle", "children": [
        { "item": "displayMode" }, { "item": "parts" }, { "item": "dopagaki" }, { "item": "statusBar" }
      ] }
    ] },
    { "id": "data", "label": "データ管理", "cat": true, "children": [
      { "item": "updateApps" }, { "item": "fxUpdate" }, { "item": "checkUpdate" }
    ] },
    { "id": "security", "label": "セキュリティ", "cat": true, "children": [
      { "item": "passcodeAuth" }, { "item": "passcodeChange" }
    ] },
    { "id": "other", "label": "その他", "cat": true, "children": [
      { "item": "sleep" }, { "item": "guideReshow" }
    ] }
  ]
}
